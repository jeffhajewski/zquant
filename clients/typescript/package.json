{
  "name": "zquant",
  "version": "0.1.0",
  "description": "TurboQuant vector quantization: a flat quantized index for vector search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prebuilds",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "build:test": "node scripts/clean.mjs build-test && tsc -p tsconfig.json",
    "test": "npm run build && npm run build:test && node --test build-test/tests/*.test.js",
    "pack:native": "sh scripts/pack.sh",
    "prepare": "npm run build"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
