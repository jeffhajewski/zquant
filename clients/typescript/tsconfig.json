{
  // Type-checks everything (`npx tsc --noEmit`) and compiles the tests, with the
  // sources they import, into build-test/. The published package is built by
  // tsconfig.build.json instead, so its output sits at dist/index.js where
  // package.json points, with no tests in it.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build-test",
    "rootDir": ".",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
